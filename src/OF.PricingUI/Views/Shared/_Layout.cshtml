<!DOCTYPE html>
<html>
<head>
    <title>Order Pricing</title>
    <link rel="shortcut icon" href="~/images/favicon.ico">
    <link href="~/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.3/font/bootstrap-icons.css">
    @RenderSection("Styles", false)
</head>

<body class="">
    <div class="page-wrapper">
        <div class="page-content" style="margin-left:10px">
            <!-- Page Content-->
            <div class="row grow w-100">
                <div class="col-12">
                    @await Html.PartialAsync("~/Views/Shared/_Header.cshtml")
                </div>
            </div>
            <div class="row grow w-100">
                <div class="main mt-2 h-100">
                    @RenderBody()
                </div>
            </div>
            <div class="row grow w-100">
                <div class="col-12">
                    @await Html.PartialAsync("~/Views/Shared/_Footer.cshtml")
                </div>
            </div>
            <!-- end page content -->
            <div class="row grow w-100 text-muted text-end">
                <div class="col-12"><i class="bi bi-info-circle" title="@ViewBag.Version"></i></div>
            </div>
        </div>
    </div>
    <script src="~/js/jquery-1.11.3.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    @RenderSection("scripts", false)
    <script src="~/js/site.js"></script>
</body>
</html>