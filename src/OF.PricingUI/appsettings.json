{
  "DetailedErrors": true,
  "Logging": {
    "LogLevel": {
      "Default": "Trace"
    },
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "excludedTypes": "Request;Exception"
      },
      "logLevel": {
        "Default": "Information",
        "Azure": "Warning",
        "Microsoft": "Warning"
      }
    }
  }
}