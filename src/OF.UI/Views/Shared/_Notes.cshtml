<div id="pnlNotesDialog" style="display:none;overflow:hidden">
    <div class="container-fluid">
        <div class="row" style="margin-top:5px!important">
            <div class="col">
                <div style="width:100%;height:400px;border:solid 1px #cacaca;overflow-y: scroll;padding:5px">
                    <div id="pnlNotes">
                    </div>
                </div>
            </div>
        </div>
        <div class="row" style="margin-top:10px!important">
            <div class="col">
                <div style="float:right;">
                    <button id="btnAddNote" class="btn btn-primary">Add Note</button>
                    <button id="btnAddNoteSave" class="btn btn-success ml-4">Save</button>
                    <button id="btnAddNoteCancel" class="btn btn-secondary ml-4">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="pnlNoteTemplate" style="display:none">
    <div class="card">
        <div class="card-header">
            <div class="continer-fluid">
                <span style="font-weight:bold" class="note_title">Title</span>
                <button style="float:right" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
            </div>
        </div>
        <div class="card-body">
            <textarea style="width:100%;resize:none" rows="5" readonly="readonly">

            </textarea>
        </div>
    </div>
</div>