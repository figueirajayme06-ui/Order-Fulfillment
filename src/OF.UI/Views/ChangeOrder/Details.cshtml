@using OF.Common
@using Infragistics.Web.Mvc
@using OF.Data.Database
@using OF.UI.Helpers
@using OF.UI.Shared.Helpers
@model OF.UI.ViewModels.ChangeOrders.ChangeOrdersViewModel
@inject OF.UI.Identity.IUserIdentity Identity

@{
    Layout = "/Views/Shared/_LayoutDialog.cshtml";
    var user = Identity.GetIdentity();
    var dateFormat = user.DateFormat;
    var uiDateFormat = user.DateFormat == "dd/MM/yyyy" ? "dd/mm/yy" : "mm/dd/yy";
    var disabled = Model.ChangeOrder.Status != (int)ChangeStatus.Pending;
    var agreementOnHire = (Model.ChangeOrder?.ChangeOrderHeader != null ? Model.ChangeOrder?.ChangeOrderHeader?.OnHireDate : Model.Header.OnHireDate);
    var agreementOffHire = (Model.ChangeOrder?.ChangeOrderHeader != null ? Model.ChangeOrder?.ChangeOrderHeader?.OffHireDate : Model.Header.OffHireDate);

    // Get the active tab from query string or set default to "details"
    var activeTab = Context.Request.Query["tab"].FirstOrDefault() ?? "details";
}

<div class="container-fluid" style="margin:0;padding:0">
    <div class="row">
        <div id="colLines" class="col-12 mr-1 mt-1">
            <div class="card">
                <h5 class="card-header"><i class="bi bi-box-seam"></i>&nbsp;Change Order for @Model.Header.AgreementNumber</h5>
                <div class="card-body">
                    <!-- Nav tabs -->
                    <ul class="nav nav-tabs" id="changeOrderTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == "details" ? "active" : "")" id="details-tab" data-bs-toggle="tab" data-bs-target="#details" type="button" role="tab" aria-controls="details" aria-selected="@(activeTab == "details" ? "true" : "false")">Details</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == "addresses" ? "active" : "")" id="addresses-tab" data-bs-toggle="tab" data-bs-target="#addresses" type="button" role="tab" aria-controls="addresses" aria-selected="@(activeTab == "addresses" ? "true" : "false")">Addresses</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == "contacts" ? "active" : "")" id="contacts-tab" data-bs-toggle="tab" data-bs-target="#contacts" type="button" role="tab" aria-controls="contacts" aria-selected="@(activeTab == "contacts" ? "true" : "false")">Contacts</button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link @(activeTab == "document" ? "active" : "")" id="document-tab" data-bs-toggle="tab" data-bs-target="#document" type="button" role="tab" aria-controls="document" aria-selected="@(activeTab == "document" ? "true" : "false")">Document</button>
                        </li>
                    </ul>

                    <!-- Tab content -->
                    <div class="tab-content" id="changeOrderTabsContent">
                        <!-- Details Tab -->
                        <div class="tab-pane fade @(activeTab == "details" ? "show active" : "")" id="details" role="tabpanel" aria-labelledby="details-tab">
                            <div class="change-body" style="overflow:hidden">
                                <div class="row mt-4">
                                    <div class="col-md-12">
                                        <div class="card">
                                            <h5 class="card-header">
                                                <i class="bi bi-info"></i> Header
                                            </h5>
                                            <div class="card-body">
                                                <!-- Header Section -->
                                                <form id="editHeaderForm" style="width: 100%" action="/ChangeOrder/EditHeader?headerId=@(Model.Header.Id)&changeId=@(Model.ChangeOrder.Id)&tab=details" method="post">
                                                    <div class="row">
                                                        <div class="col-md-6">
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">Customer Number</label>
                                                                <div class="col-md-6">
                                                                    <input type="text" readonly class="form-control-plaintext" value="@Model.Header.CustomerNumber">
                                                                </div>
                                                            </div>
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">Customer Name</label>
                                                                <div class="col-md-6">
                                                                    <input type="text" readonly class="form-control-plaintext" value="@Model.Header.CustomerName">
                                                                </div>
                                                            </div>
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">Customer Address</label>
                                                                <div class="col-md-6">
                                                                    <input type="text" readonly class="form-control-plaintext" value="@Model.Header.CustomerAddress">
                                                                </div>
                                                            </div>
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">Division</label>
                                                                <div class="col-md-6">
                                                                    <input type="text" readonly class="form-control-plaintext" value="@Model.Header.Division">
                                                                </div>
                                                            </div>
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">OnHire Date</label>
                                                                <div class="col-md-6">
                                                                    <input required
                                                                           disabled="@disabled"
                                                                           type="text"
                                                                           class="form-control"
                                                                           name="OnHireDate"
                                                                           value="@(agreementOnHire?.ToString(dateFormat))"
                                                                           data-datepicker="@uiDateFormat"
                                                                           data-original="@(Model.Header.OnHireDate?.ToString(dateFormat))">

                                                                </div>
                                                            </div>
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">OffHire Date</label>
                                                                <div class="col-md-6">
                                                                    <input required
                                                                           disabled="@disabled"
                                                                           type="text"
                                                                           class="form-control"
                                                                           name="OffHireDate"
                                                                           value="@(agreementOffHire?.ToString(dateFormat))"
                                                                           data-datepicker="@uiDateFormat"
                                                                           data-original="@(Model.Header.OffHireDate?.ToString(dateFormat))">
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-6">
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">Rate Type</label>
                                                                <div class="col-md-6">
                                                                    <input disabled="@disabled"
                                                                           type="text"
                                                                           class="form-control"
                                                                           name="RateType"
                                                                           value="@(Model.ChangeOrder?.ChangeOrderHeader?.RateType)">
                                                                </div>
                                                            </div>
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">Job AIC</label>
                                                                <div class="col-md-6">
                                                                    <input disabled="@disabled"
                                                                           type="text"
                                                                           class="form-control"
                                                                           name="JobAic"
                                                                           value="@(Model.ChangeOrder?.ChangeOrderHeader?.JobAic)">
                                                                </div>
                                                            </div>
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">Project Code</label>
                                                                <div class="col-md-6">
                                                                    <input disabled="@disabled"
                                                                           type="text"
                                                                           class="form-control"
                                                                           name="ProjectCode"
                                                                           value="@(Model.ChangeOrder?.ChangeOrderHeader?.ProjectCode)">
                                                                </div>
                                                            </div>
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">PO Number</label>
                                                                <div class="col-md-6">
                                                                    <input disabled="@disabled"
                                                                           type="text"
                                                                           class="form-control"
                                                                           name="Ponumber"
                                                                           value="@(Model.ChangeOrder?.ChangeOrderHeader?.Ponumber)">
                                                                </div>
                                                            </div>
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">PO Amount</label>
                                                                <div class="col-md-6">
                                                                    <input disabled="@disabled"
                                                                           type="text"
                                                                           class="form-control"
                                                                           name="Poamount"
                                                                           value="@(Model.ChangeOrder?.ChangeOrderHeader?.Poamount)">
                                                                </div>
                                                            </div>
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">Rental Duration</label>
                                                                <div class="col-md-6">
                                                                    <input disabled="@disabled"
                                                                           type="number"
                                                                           class="form-control"
                                                                           name="RentalDuration"
                                                                           value="@(Model.ChangeOrder?.ChangeOrderHeader?.RentalDuration)">
                                                                </div>
                                                            </div>
                                                            <div class="form-group row p-2">
                                                                <label class="col-md-6 col-form-label">Minimum Rental</label>
                                                                <div class="col-md-6">
                                                                    <input disabled="@disabled"
                                                                           type="number"
                                                                           class="form-control"
                                                                           name="MinimumRental"
                                                                           value="@(Model.ChangeOrder?.ChangeOrderHeader?.MinimumRental)">
                                                                </div>
                                                            </div>
                                                        </div>

                                                        @if (!disabled)
                                                        {
                                                            <div class="col-md-12 text-end">
                                                                <button data-enrich data-headerid="@Model.Header.Id" data-changeorderid="@Model.ChangeOrder.Id" type="submit" class="btn btn-primary" data-save title="Enrich the data on this from salesforce for pricing.">
                                                                    <i class="bi bi-reload"></i>&nbsp;Enrich From Salesforce
                                                                </button>&nbsp;
                                                                <button onclick="showLoadingModal('Saving header...')" type="submit" class="btn btn-success" data-save title="Add Line">
                                                                    <i class="bi bi-save"></i>&nbsp;Save
                                                                </button>&nbsp;
                                                            </div>
                                                        }
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Lines Section -->
                                <div class="row mt-4">
                                    <div class="col-md-6">
                                        <div class="card">
                                            <h5 class="card-header">
                                                <i class="bi bi-card-text"></i>&nbsp;Lines
                                            </h5>
                                            @if (!Model.Header.IsDeleted)
                                            {
                                                int count = 0;

                                                <div class="card-body">
                                                    <table id="table-items" class="table table-hover">
                                                        <thead>
                                                            <tr>
                                                                <th style="width:40px">Line</th>
                                                                <th style="width:100px">Generic</th>
                                                                <th style="width:80px">Qty</th>
                                                                <th style="width:80px">Price ($)</th>
                                                                <th style="width:80px">Order Source</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            @foreach (var lineWithChange in Model.Lines)
                                                            {
                                                                ChangeOrderLine? change = lineWithChange.ChangeOrderLine;
                                                                Line? line = lineWithChange?.Line;

                                                                <tr class="line_item_row @(change?.Delete == true ? "row-deleted" : line == null ? "row-added" : "") ">
                                                                    <td class="nowrap">
                                                                        <input type="hidden" name="Lines[@count].ChangeId" value="@change?.Id" />
                                                                        <input type="hidden" name="Lines[@count].LineId" value="@line?.Id" />
                                                                        <input type="hidden" name="Lines[@count].Delete" value="@((change?.Delete ?? false).ToString().ToLower())" />
                                                                        <input type="hidden" name="Lines[@count].Price" value="@change?.Price" />

                                                                        <input type="hidden"
                                                                               name="Lines[@count].GenericItemNumber"
                                                                               value="@(change != null ? change?.GenericItemNumber : line?.GenericItemNumber)"
                                                                               data-original="@(line?.GenericItemNumber)" />

                                                                        <input type="hidden"
                                                                               name="Lines[@count].Quantity"
                                                                               value="@(change != null ? change?.Quantity : line?.Quantity)"
                                                                               data-original="@(line?.Quantity)" />

                                                                        <input type="hidden"
                                                                               name="Lines[@count].Attributes"
                                                                               value="@(change != null ? change?.Attributes : line?.Attributes)"
                                                                               data-original="@(line?.Attributes)" />

                                                                        <input type="hidden"
                                                                               name="Lines[@count].DeliveryDate"
                                                                               value=@((change != null ? change?.DeliveryDate : line?.DeliveryDate)?.ToString(dateFormat))
                                                                               data-original="@(line?.DeliveryDate?.ToString(dateFormat))">

                                                                        <input type="hidden"
                                                                               name="Lines[@count].OnHireDate"
                                                                               value=@((change != null ? change?.OnHireDate : line?.ValidFromDate)?.ToString(dateFormat))
                                                                               data-original="@((line?.ValidFromDate)?.ToString(dateFormat))">

                                                                        <input type="hidden"
                                                                               name="Lines[@count].OffHireDate"
                                                                               value=@((change != null ? change?.OffHireDate : line?.ValidToDate)?.ToString(dateFormat))
                                                                               data-original="@((line?.ValidToDate)?.ToString(dateFormat))">

                                                                        <input type="hidden"
                                                                               name="Lines[@count].TerminationDate"
                                                                               value=@((change != null ? change?.TerminationDate : line?.TerminationDate)?.ToString(dateFormat))
                                                                               data-original="@(line?.TerminationDate?.ToString(dateFormat))">

                                                                        <input type="hidden"
                                                                               name="Lines[@count].CollectionDate"
                                                                               value=@((change != null ? change?.CollectionDate : line?.CollectionDate)?.ToString(dateFormat))
                                                                               data-original="@(line?.CollectionDate?.ToString(dateFormat))">

                                                                        <span>@(line?.AgreementLineNumber)</span>
                                                                    </td>
                                                                    <td class="nowrap">
                                                                        <span>@(change != null ? change?.GenericItemNumber : line?.GenericItemNumber)</span>
                                                                    </td>
                                                                    <td>
                                                                        <span>@(change != null ? change?.Quantity : line?.Quantity)</span>
                                                                    </td>
                                                                    <td>
                                                                        @if (change != null)
                                                                        {
                                                                            <span>$@change.Price</span>
                                                                        }
                                                                    </td>
                                                                    <td>
                                                                        <span>@(string.IsNullOrEmpty(line?.OrderSource) ? Constants.IPG.OrderSource : line?.OrderSource)</span>
                                                                    </td>
                                                                </tr>

                                                                count++;
                                                            }

                                                            @if (!disabled)
                                                            {
                                                                <tr class="line_item_row_last">
                                                                    <td colspan="4">
                                                                    </td>
                                                                    <td>

                                                                        <button type="button"
                                                                                data-add
                                                                                title="Add new line"
                                                                                class="btn btn-sm btn-success line_btn_fulfil float-end">
                                                                            <i class="bi bi-plus"></i> Add Line
                                                                        </button>

                                                                    </td>
                                                                </tr>
                                                            }
                                                        </tbody>
                                                    </table>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="card-body">
                                                    <div id="panel_fulfilment_blank" class="fulfilMessage">
                                                        <i class="bi bi-trash"></i>&nbsp;Quote has been deleted
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="card">
                                            <h5 class="card-header">
                                                <i class="bi bi-card-text"></i> Line Details
                                            </h5>
                                            <div class="card-body">
                                                <div id="lineForm" style="display:none;">
                                                    <form id="editLinesForm" action="/ChangeOrder/EditLine?headerId=@(Model.Header.Id)&changeOrderId=@(Model.ChangeOrder.Id)&tab=details" method="post">
                                                        <input type="hidden" name="ChangeId" value="" />
                                                        <input type="hidden" name="LineId" value="" />
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <label for="GenericItemNumber" class="form-label">Generic Item Number</label>
                                                                <div class="input-group mb-3">
                                                                    <input disabled="@disabled" readonly required type="text" class="form-control" id="GenericItemNumber" name="GenericItemNumber" />
                                                                    <button onclick="openConfiguratorView('@(Model.Header.AgreementNumber)', this)" class="btn btn-primary" disabled="@disabled" type="button">Select</button>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="mb-3">
                                                                    <label for="Quantity" class="form-label">Quantity</label>
                                                                    <input disabled="@disabled" readonly required type="number" class="form-control" id="Quantity" name="Quantity" value="1" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-12">
                                                                <div class="mb-3">
                                                                    <label for="Attributes" class="form-label">Attributes</label>
                                                                    <input type="hidden" id="Attributes" name="Attributes" />
                                                                    <div id="lineAttributes">
                                                                        <span class="badge bg-primary">None</span>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <div class="mb-3">
                                                                    <label for="DeliveryDate" class="form-label">Delivery Date</label>
                                                                    <input disabled="@disabled" type="text" class="form-control" id="DeliveryDate" name="DeliveryDate"
                                                                           data-datepicker="@uiDateFormat" />
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="mb-3">
                                                                    <label for="Price" class="form-label">Price ($)</label>
                                                                    <input disabled="@disabled" readonly type="number" class="form-control" id="Price" name="Price" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <div class="mb-3">
                                                                    <label for="OnHireDate" class="form-label">OnHire Date</label>
                                                                    <input disabled="@disabled" required type="text" class="form-control" id="OnHireDate" name="OnHireDate"
                                                                           data-datepicker="@uiDateFormat" />
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="mb-3">
                                                                    <label for="OffHireDate" class="form-label">OffHire Date</label>
                                                                    <input disabled="@disabled" required type="text" class="form-control" id="OffHireDate" name="OffHireDate"
                                                                           data-datepicker="@uiDateFormat" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <div class="mb-3">
                                                                    <label for="TerminationDate" class="form-label">Termination Date</label>
                                                                    <input disabled="@disabled" type="text" class="form-control" id="TerminationDate" name="TerminationDate"
                                                                           data-datepicker="@uiDateFormat" />
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="mb-3">
                                                                    <label for="CollectionDate" class="form-label">Collection Date</label>
                                                                    <input disabled="@disabled" type="text" class="form-control" id="CollectionDate" name="CollectionDate"
                                                                           data-datepicker="@uiDateFormat" />
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <div class="mb-3">
                                                                    <div class="form-check form-switch">
                                                                        <input disabled="@disabled" class="form-check-input" type="checkbox" id="Delete" name="Delete">
                                                                        <label class="form-check-label" for="Delete">Deleted</label>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        @if (!disabled)
                                                        {
                                                            <button id="saveButton" disabled onclick="showLoadingModal('Saving line...')" type="submit" class="btn btn-success float-end" data-save title="Save line">
                                                                <i class="bi bi-save"></i> Save
                                                            </button>
                                                        }
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- Addresses Tab -->
                        <div class="tab-pane fade @(activeTab == "addresses" ? "show active" : "")" id="addresses" role="tabpanel" aria-labelledby="addresses-tab">
                            <div class="row mt-4">
                                <div class="col-md-6">
                                    <div class="card">
                                        <h5 class="card-header">
                                            <i class="bi bi-building"></i> Billing
                                        </h5>
                                        <div class="card-body">
                                            <form id="editBillingAddressForm" action="/ChangeOrder/EditAddress?headerId=@(Model.Header.Id)&changeId=@(Model.ChangeOrder.Id)&addressType=@((int)AddressType.Invoice)&tab=addresses" method="post">
                                                <input type="hidden" name="AddressType" value="@((int)AddressType.Invoice)" />
                                                @{
                                                    var billingAddress = Model.ChangeOrder?.InvoiceAddress ?? new ChangeOrderAddress { AddressType = (int)AddressType.Invoice };
                                                }
                                                <input type="hidden" name="Id" value="@billingAddress.Id" />
                                                <input type="hidden" name="SalesforceId" value="@billingAddress.SalesforceId" />
                                                <input type="hidden" name="M3number" value="@billingAddress.M3number" />

                                                <div class="mb-3">
                                                    <label for="BillingAddressName" class="form-label">Address Name <span class="text-danger">*</span></label>
                                                    <input required
                                                           disabled="@disabled"
                                                           type="text"
                                                           class="form-control"
                                                           id="BillingAddressName"
                                                           name="AddressName"
                                                           value="@billingAddress.AddressName" />
                                                </div>
                                                <div class="mb-3">
                                                    <label for="BillingStreet" class="form-label">Street</label>
                                                    <input disabled="@disabled"
                                                           type="text"
                                                           class="form-control"
                                                           id="BillingStreet"
                                                           name="Street"
                                                           value="@billingAddress.Street" />
                                                </div>
                                                <div class="mb-3">
                                                    <label for="BillingCity" class="form-label">City <span class="text-danger">*</span></label>
                                                    <input required
                                                           disabled="@disabled"
                                                           type="text"
                                                           class="form-control"
                                                           id="BillingCity"
                                                           name="City"
                                                           value="@billingAddress.City" />
                                                </div>
                                                <div class="row">
                                                    <div class="col-md-6">
                                                        <div class="mb-3">
                                                            <label for="BillingStateOrProvince" class="form-label">State/Province</label>
                                                            <input disabled="@disabled"
                                                                   type="text"
                                                                   class="form-control"
                                                                   id="BillingStateOrProvince"
                                                                   name="StateOrProvince"
                                                                   value="@billingAddress.StateOrProvince" />
                                                        </div>
                                                    </div>
                                                    <div class="col-md-6">
                                                        <div class="mb-3">
                                                            <label for="BillingZipOrPostalCode" class="form-label">Zip/Postal Code <span class="text-danger">*</span></label>
                                                            <input required
                                                                   disabled="@disabled"
                                                                   type="text"
                                                                   class="form-control"
                                                                   id="BillingZipOrPostalCode"
                                                                   name="ZipOrPostalCode"
                                                                   value="@billingAddress.ZipOrPostalCode" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="BillingCountry" class="form-label">Country <span class="text-danger">*</span></label>
                                                    <input required
                                                           disabled="@disabled"
                                                           type="text"
                                                           class="form-control"
                                                           id="BillingCountry"
                                                           name="Country"
                                                           value="@billingAddress.Country" />
                                                </div>

                                                @if (!disabled)
                                                {
                                                    <button onclick="setFalse(this, 'Saving billing address...')" type="submit" class="btn btn-success float-end">
                                                        <i class="bi bi-save"></i>&nbsp;Save
                                                    </button>
                                                }
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="card">
                                        <h5 class="card-header">
                                            <i class="bi bi-geo-alt"></i> Shipping
                                        </h5>
                                        <div class="card-body">
                                            <form id="editShippingAddressForm" action="/ChangeOrder/EditAddress?headerId=@(Model.Header.Id)&changeId=@(Model.ChangeOrder.Id)&addressType=@((int)AddressType.Shipping)&tab=addresses" method="post">
                                                @{
                                                    var shippingAddress = Model.ChangeOrder?.SiteAddress ?? new ChangeOrderAddress { AddressType = (int)AddressType.Shipping };
                                                }
                                                <input type="hidden" name="Id" value="@shippingAddress.Id" />
                                                <input type="hidden" name="SalesforceId" value="@shippingAddress.SalesforceId" />
                                                <input type="hidden" name="M3number" value="@shippingAddress.M3number" />

                                                <div class="mb-3">
                                                    <label for="ShippingAddressName" class="form-label">Address Name <span class="text-danger">*</span></label>
                                                    <input required
                                                           disabled="@disabled"
                                                           type="text"
                                                           class="form-control"
                                                           id="ShippingAddressName"
                                                           name="AddressName"
