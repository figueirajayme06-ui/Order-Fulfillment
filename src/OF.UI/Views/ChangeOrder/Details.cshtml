    <div class="row">
        @if (Model.ChangeOrder.Status == (int)ChangeStatus.Pending)
        {
            if (User.IsInRole(Constants.Roles.ChangeOrder))
            {
                <div class="col-12 text-center mt-4">
                    <div class="card">
                        <h5 class="card-header">
                            <i class="bi bi-card-text"></i> Comment
                        </h5>
                        <div class="card-body">
                            <form action="/ChangeOrder/SendOrDelete?headerId=@(Model.Header.Id)&changeId=@(Model.ChangeOrder.Id)" method="post">
                                <div class="mb-3">
                                    <textarea class="form-control" id="SendComment" name="Comment" rows="3"></textarea>
                                </div>
                                <input type="hidden" name="Value" value="true" />
                                <button type="submit" class="btn btn-primary mr-1" onclick="showLoadingModal('Approving...')">Send for Approval</button>
                                <button type="submit" class="btn btn-danger" onclick="setFalse(this, 'Deleting change...')">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        else if (Model.ChangeOrder.Status == (int)ChangeStatus.Requested)
        {
            if (User.IsInRole(Constants.Roles.ChangeApproval))
            {
                <div class="col-12 text-center mt-4">
                    <div class="card">
                        <h5 class="card-header">
                            <i class="bi bi-card-text"></i> Comment
                        </h5>
                        <div class="card-body">
                            <form action="/ChangeOrder/ApproveOrReject?headerId=@(Model.Header.Id)&changeId=@(Model.ChangeOrder.Id)" method="post">
                                <div class="mb-3">
                                    <textarea required class="form-control" id="ApprovalComment" name="Comment" rows="3"></textarea>
                                </div>

                                <input type="hidden" name="Value" value="true" />
                                <button type="submit" class="btn btn-success mr-1" onclick="showLoadingModal('Approving...')">Approve</button>
                                <button type="submit" class="btn btn-danger" onclick="setFalse(this, 'Rejecting...')">Reject</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
        @if (Model.ChangeOrder.Status != (int)ChangeStatus.Pending)
        {
            <div class="col-12 mt-1">
                <ul class="timeline">
                    @foreach (var comment in Model.ChangeOrderComments)
                    {
                        <li class="change-comment@(comment.Status.HasValue ? $"-{comment.Status.ToString().ToLower()}" : "")">
                            <span class="float-right fw-bold">@(comment.CreatedOn.ToString(user.DateFormat)) by @comment.CreatedBy</span>
                            @switch (comment.Status)
                            {
                                case ChangeStatus.Approved:
                                    <i class="bi bi-check text-success"></i>
                                    break;
                                case ChangeStatus.Rejected:
                                    <i class="bi bi-x-circle text-danger"></i>
                                    break;
                                case ChangeStatus.Requested:
                                    <i class="bi bi-arrow-clockwise text-info"></i>
                                    break;
                                case ChangeStatus.Completed:
                                    <i class="bi bi-check-circle-fill text-success"></i>
                                    break;
                                default:
                                    <i class="bi bi-chat-dots"></i>
                                    break;
                            }
                            <p>@comment.Comment</p>
                        </li>
                    }
                    <li>
                        <form action="/ChangeOrder/AddComment?headerId=@(Model.Header.Id)&changeId=@(Model.ChangeOrder.Id)" method="post">
                            <div class="my-3">
                                <label for="Comment" class="form-label">Comment</label>
                                <textarea required class="form-control" id="Comment" name="Comment" rows="3"></textarea>
                            </div>
                            <button type="submit" class="btn btn-success mr-1 float-end" onclick="setFalse(this, 'Commenting...')">Add Comment</button>
                        </form>
                    </li>
                </ul>
            </div>
        }
    </div>
</div>

<div id="dialogConfigurator" style="display:none;overflow:hidden">
    <iframe id="frameConfigurator" style="overflow:hidden" src="about:blank" frameborder="0" width="100%" height="100%"></iframe>
</div>

<!-- Modal Overlay -->
<div class="modal fade" id="loadingModal" tabindex="-1" aria-labelledby="loadingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: rgba(255, 255, 255, 0.8);">
            <div class="modal-body text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p id="loadingMessage" class="mt-3">Saving</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script>
        function getPriceSerialised(generic, offHire, onHire, quantity) {
            var json = {
                "id": "requestId",
                "quote": {
                    "details": {
                        "currencyISOCode": "GBP",
                        "division": "@(Model.Header.Division)",
                        "onHire": "@(Model.Header.OnHireDate!.Value.ToString("yyyy-MM-dd"))",
                        "offHire": "@(Model.Header.OffHireDate!.Value.ToString("yyyy-MM-dd"))",
                        "warehouse": "@(Model.Header.RentalDepot)",
                        "jobAICCode": "1000"
                    },
                    "lines": [
                        {
                            "generic": generic,
                            "offHire": offHire,
                            "onHire": onHire,
                            "quantity": quantity
                        }
                    ]
                }
            }

            return JSON.stringify(json);
        }
    </script>
    <script type="text/javascript" src="~/js/site/changeCore.js" asp-append-version="true"></script>
    <script>
        function updateUrl() {
            window.parent.removeChangePushState();
        }
    </script>
}
