root = true

[*.{cs,cshtml}]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = crlf
trim_trailing_whitespace = true

dotnet_sort_system_directives_first = false
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped

[*.sql]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = crlf
trim_trailing_whitespace = true

[*.{js}]
indent_style = space
indent_size = 4
charset = utf-8
end_of_line = crlf
trim_trailing_whitespace = true